@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>BoxieHub - Your Personal Audio Library for Tonies</PageTitle>

<div class="pageStyle">
    <!-- Hero Section -->
    <div class="hero-section">
        <div class="container-xxl">
            <div class="row align-items-center py-5">
                <div class="col-lg-6 order-last order-lg-first">
                    <div class="hero-content">
                        <h1 class="hero-title mb-4">
                            <i class="bi bi-box text-primary"></i> BoxieHub
                        </h1>
                        <p class="hero-subtitle mb-4">
                            Transform your Tonies experience with smart audio management
                        </p>
                        <p class="lead text-muted mb-4">
                            Import from YouTube, podcasts, or upload your own audio. 
                            Organize your media library and seamlessly upload to your Tonies.
                        </p>
                        <div class="d-flex gap-3 flex-wrap">
                            <AuthorizeView>
                                <Authorized>
                                    <a href="/library" class="btn btn-primary btn-lg">
                                        <i class="bi bi-collection-play"></i> Go to Library
                                    </a>
                                    <a href="/tonies" class="btn btn-outline-primary btn-lg">
                                        <i class="bi bi-music-note-list"></i> My Tonies
                                    </a>
                                </Authorized>
                                <NotAuthorized>
                                    <a href="/Account/Register" class="btn btn-primary btn-lg">
                                        <i class="bi bi-person-plus"></i> Get Started Free
                                    </a>
                                    <a href="/Account/Login" class="btn btn-outline-primary btn-lg">
                                        <i class="bi bi-box-arrow-in-right"></i> Sign In
                                    </a>
                                </NotAuthorized>
                            </AuthorizeView>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 text-center mb-5 mb-lg-0">
                    <div class="hero-image">
                        <i class="bi bi-box hero-icon text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="features-section py-5 bg-light">
        <div class="container-xxl">
            <div class="text-center mb-5">
                <h2 class="section-title">Everything You Need for Your Tonies</h2>
                <p class="text-muted">Powerful features to manage and organize your audio content</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="feature-icon bg-danger">
                            <i class="bi bi-youtube"></i>
                        </div>
                        <h3>YouTube Import</h3>
                        <p>Import audio from any YouTube video or entire playlists. Perfect for songs, stories, and educational content.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="feature-icon bg-info">
                            <i class="bi bi-broadcast"></i>
                        </div>
                        <h3>Podcast Management</h3>
                        <p>Subscribe to your favorite podcasts with RSS feeds. Track episodes and import them directly to your library.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="feature-icon bg-success">
                            <i class="bi bi-upload"></i>
                        </div>
                        <h3>File Upload</h3>
                        <p>Upload your own audio files in various formats. Organize personal recordings, music, and more.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="feature-icon bg-primary">
                            <i class="bi bi-collection-play"></i>
                        </div>
                        <h3>Media Library</h3>
                        <p>Centralized library with smart organization. Edit metadata, manage categories, and search with ease.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="feature-icon bg-warning">
                            <i class="bi bi-music-note-list"></i>
                        </div>
                        <h3>Tonie Integration</h3>
                        <p>Seamlessly upload audio to your Creative-Tonies. Manage multiple accounts and households in one place.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4">
                    <div class="feature-card">
                        <div class="feature-icon bg-secondary">
                            <i class="bi bi-hdd"></i>
                        </div>
                        <h3>Flexible Storage</h3>
                        <p>Choose between local database storage or AWS S3. Scale as your library grows with your needs.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- How It Works Section -->
    <div class="how-it-works-section py-5">
        <div class="container-xxl">
            <div class="text-center mb-5">
                <h2 class="section-title">How It Works</h2>
                <p class="text-muted">Get started in minutes</p>
            </div>
            <div class="row g-4">
                <div class="col-md-3">
                    <div class="step-card">
                        <div class="step-number">1</div>
                        <h4>Import Audio</h4>
                        <p>From YouTube, podcasts, or upload your own files</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="step-card">
                        <div class="step-number">2</div>
                        <h4>Organize Library</h4>
                        <p>Edit metadata, categorize, and manage your content</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="step-card">
                        <div class="step-number">3</div>
                        <h4>Connect Tonies</h4>
                        <p>Link your Tonie account and select your Creative-Tonies</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="step-card">
                        <div class="step-number">4</div>
                        <h4>Upload & Enjoy</h4>
                        <p>Send audio to your Tonies with one click</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tech Stack Section -->
    <div class="tech-section py-5 bg-light">
        <div class="container-xxl">
            <div class="text-center mb-4">
                <h2 class="section-title">Built with Modern Technology</h2>
                <p class="text-muted">Powered by .NET 8 and Blazor</p>
            </div>
            <div class="d-flex justify-content-center gap-4 flex-wrap tech-icons">
                <div class="tech-item" title="C#">
                    <i class="devicons devicon-csharp-plain colored"></i>
                    <span>C#</span>
                </div>
                <div class="tech-item" title=".NET">
                    <i class="devicons devicon-dotnetcore-plain colored"></i>
                    <span>.NET 8</span>
                </div>
                <div class="tech-item" title="Bootstrap">
                    <i class="devicons devicon-bootstrap-plain colored"></i>
                    <span>Bootstrap</span>
                </div>
                <div class="tech-item" title="PostgreSQL">
                    <i class="devicons devicon-postgresql-plain colored"></i>
                    <span>PostgreSQL</span>
                </div>
                <div class="tech-item" title="AWS">
                    <i class="devicons devicon-amazonwebservices-plain-wordmark colored"></i>
                    <span>AWS S3</span>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA Section -->
    <div class="cta-section py-5">
        <div class="container-xxl text-center">
            <h2 class="mb-4">Ready to Enhance Your Tonies Experience?</h2>
            <p class="lead text-muted mb-4">Join BoxieHub today and take control of your audio library</p>
            <AuthorizeView>
                <NotAuthorized>
                    <a href="/Account/Register" class="btn btn-primary btn-lg">
                        <i class="bi bi-rocket-takeoff"></i> Get Started Now
                    </a>
                </NotAuthorized>
                <Authorized>
                    <a href="/library" class="btn btn-primary btn-lg">
                        <i class="bi bi-collection-play"></i> Go to Your Library
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</div>
