@page "/tonies/uploads"
@rendermode InteractiveServer
@using BoxieHub.Services.Tonie
@using BoxieHub.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@inject ITonieUploadJobService JobService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<Uploads> Logger
@attribute [Authorize]

<PageTitle>My Uploads - BoxieHub</PageTitle>

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/tonies">My Tonies</a></li>
            <li class="breadcrumb-item active">Upload History</li>
        </ol>
    </nav>

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">
                <i class="bi bi-upload"></i> My Upload History
            </h3>
        </div>
        <div class="card-body">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2 text-muted">Loading uploads...</p>
                </div>
            }
            else if (!jobs.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">No uploads yet</p>
                    <a href="/tonies" class="btn btn-primary">
                        <i class="bi bi-disc"></i> Go to My Tonies
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Chapter</th>
                                <th>Tonie</th>
                                <th>Status</th>
                                <th>Progress</th>
                                <th>Started</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in jobs)
                            {
                                <tr>
                                    <td>
                                        <strong>@job.ChapterTitle</strong>
                                        @if (job.MediaLibraryItemId.HasValue)
                                        {
                                            <br />
                                            <small class="text-muted">
                                                <a href="/library/@job.MediaLibraryItemId" class="text-decoration-none">
                                                    <i class="bi bi-collection-play"></i> From Library
                                                </a>
                                            </small>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @job.TonieId.Substring(0, 8)...
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(job.StatusEnum)">
                                            @job.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (job.StatusEnum is TonieUploadJobStatus.Preparing 
                                            or TonieUploadJobStatus.Uploading 
                                            or TonieUploadJobStatus.Refreshing)
                                        {
                                            <div class="progress" style="width: 100px;">
                                                <div class="progress-bar progress-bar-striped progress-bar-animated" 
                                                     style="width: @(job.ProgressPercentage)%">
                                                    @job.ProgressPercentage%
                                                </div>
                                            </div>
                                        }
                                        else if (job.StatusEnum == TonieUploadJobStatus.Completed)
                                        {
                                            <i class="bi bi-check-circle text-success"></i> 100%
                                        }
                                        else if (job.StatusEnum == TonieUploadJobStatus.Failed)
                                        {
                                            <i class="bi bi-x-circle text-danger"></i> Failed
                                        }
                                        else
                                        {
                                            <span class="text-muted">@job.ProgressPercentage%</span>
                                        }
                                    </td>
                                    <td>
                                        <small>@job.Created.ToString("MMM dd, yyyy")</small>
                                        <br />
                                        <small class="text-muted">@job.Created.ToString("h:mm tt")</small>
                                    </td>
                                    <td>
                                        @if (job.StatusEnum is TonieUploadJobStatus.Pending 
                                            or TonieUploadJobStatus.Preparing 
                                            or TonieUploadJobStatus.Uploading 
                                            or TonieUploadJobStatus.Refreshing)
                                        {
                                            <a href="/tonies/upload-progress/@job.Id" class="btn btn-sm btn-primary">
                                                <i class="bi bi-eye"></i> View Progress
                                            </a>
                                        }
                                        else if (job.StatusEnum == TonieUploadJobStatus.Completed)
                                        {
                                            <a href="/tonies/@job.HouseholdId/@job.TonieId" class="btn btn-sm btn-success">
                                                <i class="bi bi-disc"></i> View Tonie
                                            </a>
                                        }
                                        else if (job.StatusEnum == TonieUploadJobStatus.Failed)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" 
                                                    data-bs-toggle="tooltip" 
                                                    title="@job.ErrorMessage">
                                                <i class="bi bi-exclamation-triangle"></i> Details
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (TotalPages > 1)
                {
                    <nav aria-label="Upload pagination" class="mt-3">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                                    Previous
                                </button>
                            </li>
                            @for (int i = 1; i <= TotalPages; i++)
                            {
                                var pageNumber = i;
                                <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                    <button class="page-link" @onclick="() => GoToPage(pageNumber)">
                                        @pageNumber
                                    </button>
                                </li>
                            }
                            <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                                    Next
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

@code {
    private List<TonieUploadJob> jobs = new();
    private bool isLoading = true;
    private int currentPage = 1;
    private const int PageSize = 20;
    private int totalCount = 0;

    private int TotalPages => (int)Math.Ceiling((double)totalCount / PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadJobs();
        
        // Start polling for active jobs
        StartPolling();
    }

    private async Task LoadJobs()
    {
        isLoading = true;
        
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (!string.IsNullOrEmpty(userId))
            {
                // Get user's jobs with pagination
                var skip = (currentPage - 1) * PageSize;
                jobs = await JobService.GetUserJobsAsync(userId, PageSize, skip);
                
                // Get total count
                totalCount = await JobService.GetUserJobCountAsync(userId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load upload jobs");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        currentPage = page;
        _ = LoadJobs();
    }

    private string GetStatusBadgeClass(TonieUploadJobStatus status) => status switch
    {
        TonieUploadJobStatus.Completed => "bg-success",
        TonieUploadJobStatus.Failed => "bg-danger",
        TonieUploadJobStatus.Cancelled => "bg-secondary",
        TonieUploadJobStatus.Uploading => "bg-primary",
        TonieUploadJobStatus.Preparing => "bg-info",
        _ => "bg-warning"
    };

    private System.Threading.Timer? pollTimer;

    private void StartPolling()
    {
        // Poll every 3 seconds if there are active jobs
        var hasActiveJobs = jobs.Any(j => j.StatusEnum is TonieUploadJobStatus.Pending 
            or TonieUploadJobStatus.Preparing 
            or TonieUploadJobStatus.Uploading 
            or TonieUploadJobStatus.Refreshing);

        if (hasActiveJobs)
        {
            pollTimer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadJobs();
                    StateHasChanged();
                });
            }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        }
    }

    public void Dispose()
    {
        pollTimer?.Dispose();
    }
}
