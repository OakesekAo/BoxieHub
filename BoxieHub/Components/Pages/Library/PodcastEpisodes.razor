@rendermode InteractiveServer
@page "/library/podcasts/{podcastId:int}"
@using BoxieHub.Services.Import
@using BoxieHub.Models
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@inject ISavedPodcastService SavedPodcastService
@inject IImportJobService ImportJobService
@inject ImportJobProcessor JobProcessor
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ILogger<PodcastEpisodes> Logger
@attribute [Authorize]

<PageTitle>@podcastTitle - BoxieHub</PageTitle>

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/library">Library</a></li>
            <li class="breadcrumb-item"><a href="/library/podcasts">My Podcasts</a></li>
            <li class="breadcrumb-item active">@podcastTitle</li>
        </ol>
    </nav>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2 text-muted">Loading episodes...</p>
        </div>
    }
    else if (subscription == null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-x-circle"></i> Podcast not found or you don't have access to it.
            <a href="/library/podcasts" class="alert-link">Go back to My Podcasts</a>
        </div>
    }
    else
    {
        <!-- Podcast Header Component -->
        <PodcastHeaderComponent Subscription="@subscription" OnRefresh="@RefreshFeed" IsRefreshing="@isRefreshing" />

        <!-- Search & Filter Controls -->
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" 
                                   class="form-control" 
                                   placeholder="Search episodes by title or description..."
                                   @bind="searchQuery"
                                   @bind:event="oninput" />
                            @if (!string.IsNullOrEmpty(searchQuery))
                            {
                                <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                                    <i class="bi bi-x"></i>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select class="form-select" @bind="sortOrder">
                            <option value="newest">Newest First</option>
                            <option value="oldest">Oldest First</option>
                            <option value="title">Title (A-Z)</option>
                            <option value="duration">Duration</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Episodes List -->
        @if (FilteredEpisodes.Any())
        {
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-music-note-list"></i> Episodes</h5>
                        <span class="text-muted">
                            Showing @FilteredEpisodes.Count() of @allEpisodes.Count episode(s)
                        </span>
                    </div>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var episode in FilteredEpisodes)
                    {
                        <div class="list-group-item">
                            <div class="row align-items-center">
                                <div class="col-md-2 text-center">
                                    @if (!string.IsNullOrEmpty(episode.ImageUrl))
                                    {
                                        <img src="@episode.ImageUrl" 
                                             alt="@episode.Title" 
                                             class="img-thumbnail"
                                             style="max-width: 100px;">
                                    }
                                    else if (!string.IsNullOrEmpty(subscription.SavedPodcast?.ImageUrl))
                                    {
                                        <img src="@subscription.SavedPodcast.ImageUrl" 
                                             alt="@episode.Title" 
                                             class="img-thumbnail"
                                             style="max-width: 100px;">
                                    }
                                </div>
                                <div class="col-md-7">
                                    <h6 class="mb-1">@episode.Title</h6>
                                    <p class="text-muted small mb-2">
                                        @if (episode.Description.Length > 200)
                                        {
                                            @episode.Description.Substring(0, 200)<text>...</text>
                                        }
                                        else
                                        {
                                            @episode.Description
                                        }
                                    </p>
                                    <div class="d-flex gap-3">
                                        <small class="text-muted">
                                            <i class="bi bi-calendar"></i> @episode.PublishDate.ToString("MMM dd, yyyy")
                                        </small>
                                        @if (episode.DurationSeconds > 0)
                                        {
                                            <small class="text-muted">
                                                <i class="bi bi-clock"></i> @FormatDuration(TimeSpan.FromSeconds(episode.DurationSeconds / 1000.0))
                                            </small>
                                        }
                                        @if (episode.FileSizeBytes > 0)
                                        {
                                            <small class="text-muted">
                                                <i class="bi bi-hdd"></i> @FormatFileSize(episode.FileSizeBytes)
                                            </small>
                                        }
                                    </div>
                                    
                                    <!-- Deduplication Status -->
                                    @if (episode.FileUploadId.HasValue)
                                    {
                                        <span class="badge bg-success mt-2">
                                            <i class="bi bi-cloud-check"></i> Already Downloaded (@episode.ImportCount import(s))
                                        </span>
                                    }
                                </div>
                                <div class="col-md-3 text-end">
                                    @if (episode.FileUploadId.HasValue)
                                    {
                                        <!-- Episode already downloaded - instant import! -->
                                        <button class="btn btn-success btn-sm" 
                                                @onclick="() => ImportEpisode(episode)"
                                                disabled="@IsImporting(episode.Id)">
                                            @if (IsImporting(episode.Id))
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                            }
                                            <i class="bi bi-lightning-fill"></i> Instant Import
                                        </button>
                                        <small class="d-block text-muted mt-1">
                                            No download needed!
                                        </small>
                                    }
                                    else
                                    {
                                        <!-- Episode not downloaded yet -->
                                        <button class="btn btn-primary btn-sm" 
                                                @onclick="() => ImportEpisode(episode)"
                                                disabled="@IsImporting(episode.Id)">
                                            @if (IsImporting(episode.Id))
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                            }
                                            <i class="bi bi-download"></i> Download & Import
                                        </button>
                                        @if (episode.FileSizeBytes > 0)
                                        {
                                            <small class="d-block text-muted mt-1">
                                                ~@FormatFileSize(episode.FileSizeBytes)
                                            </small>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Pagination -->
            @if (TotalPages > 1)
            {
                <nav aria-label="Episode pagination" class="mt-3">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">
                                <i class="bi bi-chevron-left"></i> Previous
                            </button>
                        </li>
                        
                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(TotalPages, currentPage + 2); i++)
                        {
                            var pageNumber = i;
                            <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                            </li>
                        }
                        
                        <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">
                                Next <i class="bi bi-chevron-right"></i>
                            </button>
                        </li>
                    </ul>
                </nav>
            }
        }
        else if (!string.IsNullOrEmpty(searchQuery))
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No episodes match your search for "<strong>@searchQuery</strong>".
                <button class="btn btn-link" @onclick="ClearSearch">Clear search</button>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No episodes cached yet. Click "Refresh Feed" to load episodes.
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
            <i class="bi bi-check-circle"></i> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
            <i class="bi bi-x-circle"></i> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }
</div>

@code {
    [Parameter]
    public int PodcastId { get; set; }

    private PodcastSubscription? subscription;
    private List<PodcastEpisodeCache> allEpisodes = new();
    private HashSet<int> importingEpisodes = new();
    private bool isLoading = true;
    private bool isRefreshing = false;
    private string? errorMessage;
    private string? successMessage;
    private string podcastTitle = "Podcast";
    
    // Search & pagination
    private string searchQuery = string.Empty;
    private string sortOrder = "newest";
    private int currentPage = 1;
    private const int PageSize = 20;

    private IEnumerable<PodcastEpisodeCache> FilteredEpisodes
    {
        get
        {
            var filtered = allEpisodes.AsEnumerable();

            // Apply search filter
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                var lowerQuery = searchQuery.ToLower();
                filtered = filtered.Where(e =>
                    e.Title.ToLower().Contains(lowerQuery) ||
                    (e.Description?.ToLower().Contains(lowerQuery) ?? false));
            }

            // Apply sorting
            filtered = sortOrder switch
            {
                "oldest" => filtered.OrderBy(e => e.PublishDate),
                "title" => filtered.OrderBy(e => e.Title),
                "duration" => filtered.OrderByDescending(e => e.DurationSeconds),
                _ => filtered.OrderByDescending(e => e.PublishDate) // newest (default)
            };

            // Apply pagination
            return filtered.Skip((currentPage - 1) * PageSize).Take(PageSize);
        }
    }

    private int TotalPages => (int)Math.Ceiling((double)GetFilteredCount() / PageSize);

    private int GetFilteredCount()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
            return allEpisodes.Count;

        var lowerQuery = searchQuery.ToLower();
        return allEpisodes.Count(e =>
            e.Title.ToLower().Contains(lowerQuery) ||
            (e.Description?.ToLower().Contains(lowerQuery) ?? false));
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPodcastAndEpisodes();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (subscription?.SavedPodcastId != PodcastId)
        {
            await LoadPodcastAndEpisodes();
        }
    }

    private async Task LoadPodcastAndEpisodes()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (!string.IsNullOrEmpty(userId))
            {
                subscription = await SavedPodcastService.GetSubscriptionAsync(PodcastId, userId);
                
                if (subscription != null)
                {
                    podcastTitle = subscription.SavedPodcast?.Title ?? "Podcast";
                    
                    // Load ALL episodes (not paginated at service level)
                    allEpisodes = await SavedPodcastService.GetCachedEpisodesAsync(
                        PodcastId, userId, 0, 10000); // Load up to 10k episodes
                    
                    // If no episodes cached, automatically refresh the feed
                    if (allEpisodes.Count == 0 && subscription.SavedPodcast != null)
                    {
                        Logger.LogInformation("No episodes cached for podcast {PodcastId}, auto-refreshing feed", PodcastId);
                        await RefreshFeed();
                    }
                    else
                    {
                        Logger.LogInformation("Loaded {Count} episodes for podcast {PodcastId}", 
                            allEpisodes.Count, PodcastId);
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load podcast {PodcastId}", PodcastId);
            errorMessage = "Failed to load podcast. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshFeed()
    {
        isRefreshing = true;
        errorMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (!string.IsNullOrEmpty(userId))
            {
                await SavedPodcastService.RefreshPodcastAsync(PodcastId, userId);
                
                // Reload all episodes
                allEpisodes = await SavedPodcastService.GetCachedEpisodesAsync(
                    PodcastId, userId, 0, 10000);
                
                currentPage = 1; // Reset to first page
                successMessage = "Podcast feed refreshed successfully!";
                Logger.LogInformation("Refreshed podcast {PodcastId}", PodcastId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh podcast {PodcastId}", PodcastId);
            errorMessage = "Failed to refresh feed. Please try again.";
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private async Task ImportEpisode(PodcastEpisodeCache episode)
    {
        importingEpisodes.Add(episode.Id);
        errorMessage = null;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

            if (!string.IsNullOrEmpty(userId))
            {
                var podcastEpisode = new PodcastEpisode
                {
                    Id = episode.EpisodeGuid,
                    Title = episode.Title,
                    Description = episode.Description,
                    AudioUrl = episode.AudioUrl,
                    Duration = TimeSpan.FromSeconds(episode.DurationSeconds),
                    FileSizeBytes = episode.FileSizeBytes,
                    PublishDate = episode.PublishDate,
                    ImageUrl = episode.ImageUrl,
                    ContentType = episode.ContentType
                };

                var job = await ImportJobService.CreatePodcastImportJobAsync(
                    userId, 
                    subscription?.SavedPodcast?.FeedUrl ?? "", 
                    podcastEpisode);

                await JobProcessor.EnqueueJobAsync(job.Id);

                if (episode.FileUploadId.HasValue)
                {
                    successMessage = $"'{episode.Title}' added to library instantly (reused existing file)!";
                    episode.ImportCount++;
                }
                else
                {
                    successMessage = $"'{episode.Title}' queued for download. Check library for progress.";
                }
                
                Logger.LogInformation("Started import job {JobId} for episode {EpisodeId}", 
                    job.Id, episode.Id);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to import episode {EpisodeId}", episode.Id);
            errorMessage = $"Failed to import '{episode.Title}'. Please try again.";
        }
        finally
        {
            importingEpisodes.Remove(episode.Id);
        }
    }

    private bool IsImporting(int episodeId) => importingEpisodes.Contains(episodeId);

    private void ClearSearch()
    {
        searchQuery = string.Empty;
        currentPage = 1;
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        currentPage = page;
    }

    private string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
            return $"{(int)duration.TotalHours}h {duration.Minutes}m";
        if (duration.TotalMinutes >= 1)
            return $"{duration.Minutes}m {duration.Seconds}s";
        return $"{duration.Seconds}s";
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}

